<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DATN_MD13"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".Activity.AreaPickerActivity"
            android:exported="false" />
        <activity
            android:name=".Activity.Activity_seat_selection"
            android:exported="false" />
        <activity
            android:name=".Activity.ShowtimesByCinemaActivity"
            android:exported="false" />
        <activity
            android:name=".Activity.Activity_member"
            android:exported="false" />
        <activity
            android:name=".Activity.Register"
            android:exported="false"
            android:theme="@style/Theme.DATN_MD13" />
        <activity
            android:name=".Activity.Login"
            android:exported="true" />
        <activity
            android:name=".BookingByMovieActivity"
            android:exported="false" />
        <activity
            android:name=".activity_movie_detail"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>