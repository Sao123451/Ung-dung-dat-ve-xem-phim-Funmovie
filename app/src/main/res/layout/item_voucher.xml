<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/bg_voucher_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">

    <TextView
        android:id="@+id/tvCode"
        android:text="SEAT10"
        android:textStyle="bold"
        android:textSize="20sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/tvDiscount"
        android:text="Giảm 10%"
        android:textColor="#1563FF"
        android:layout_marginTop="4dp"
        android:textSize="16sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/tvEndDate"
        android:text="HSD: 2025-12-31"
        android:layout_marginTop="6dp"
        android:textSize="14sp"
        android:textColor="#444"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/tvUsage"
        android:text="Đã dùng: 1/100"
        android:layout_marginTop="4dp"
        android:textSize="14sp"
        android:textColor="#777"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/tvUsed"
        android:text="ĐÃ SỬ DỤNG"
        android:textColor="#E53935"
        android:textSize="14sp"
        android:layout_marginTop="4dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

</LinearLayout>
