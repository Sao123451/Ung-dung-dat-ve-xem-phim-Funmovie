<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F4F6">

    <!-- APP BAR -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_appbar_gradient"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="Chi tiết vé"
        app:titleCentered="true"
        android:theme="@style/ThemeOverlay.Material3.Dark.ActionBar" />

    <!-- SCROLL -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- MAIN CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:orientation="vertical"
                android:background="@drawable/bg_ticket_gradient"
                android:elevation="6dp"
                android:clipToPadding="false"
                android:layout_marginTop="12dp">

                <!-- Poster -->
                <ImageView
                    android:id="@+id/imgPoster"
                    android:layout_width="200dp"
                    android:layout_height="300dp"
                    android:layout_gravity="center"
                    android:scaleType="centerCrop"
                    android:background="@drawable/bg_poster"
                    android:clipToOutline="true"
                    android:elevation="4dp" />

                <!-- Reservation Code -->
                <TextView
                    android:id="@+id/tvCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FF6F00"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:gravity="center"
                    android:layout_marginTop="14dp" />

                <!-- Date -->
                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#6A6A6A"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:layout_marginTop="4dp" />

                <!-- Movie name -->
                <TextView
                    android:id="@+id/tvMovieName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#111111"
                    android:letterSpacing="0.02"
                    android:gravity="center"
                    android:layout_marginTop="12dp" />

                <!-- Showtime Label -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SUẤT CHIẾU"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:textColor="#888888"
                    android:letterSpacing="0.1"
                    android:gravity="center"
                    android:layout_marginTop="12dp" />

                <!-- Showtime Info -->
                <TextView
                    android:id="@+id/tvShowInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textColor="#333333"
                    android:gravity="center"
                    android:layout_marginTop="2dp" />

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginVertical="16dp" />

                <!-- Seats Label -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="GHẾ ĐÃ CHỌN"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:textColor="#888888"
                    android:letterSpacing="0.1"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvSeats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="17sp"
                    android:textColor="#111111"
                    android:layout_marginTop="2dp" />

                <!-- Combos Label -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="COMBO ĐỒ ĂN"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:textColor="#888888"
                    android:letterSpacing="0.1"
                    android:layout_marginTop="16dp" />

                <TextView
                    android:id="@+id/tvCombos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textColor="#111111"
                    android:layout_marginTop="2dp" />

                <!-- Payment Label -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PHƯƠNG THỨC THANH TOÁN"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:textColor="#888888"
                    android:letterSpacing="0.1"
                    android:layout_marginTop="16dp" />

                <TextView
                    android:id="@+id/tvPayment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textColor="#111111"
                    android:layout_marginTop="2dp" />

                <!-- Total Label -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="TỔNG THANH TOÁN"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:textColor="#D84315"
                    android:letterSpacing="0.1"
                    android:layout_marginTop="20dp" />

                <!-- Total Value -->
                <TextView
                    android:id="@+id/tvTotal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#E65100"
                    android:layout_marginTop="4dp" />

                <!-- QR CODE AREA -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_qr_glass"
                    android:padding="20dp"
                    android:elevation="8dp">

                    <ImageView
                        android:id="@+id/imgQr"
                        android:layout_width="220dp"
                        android:layout_height="220dp"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
