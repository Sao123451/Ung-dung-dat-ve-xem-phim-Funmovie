<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="32dp">   <!-- 📌 Thêm khoảng cách với Status Bar -->

    <!-- ================== TOOLBAR ĐẸP ================== -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/camdep"
        android:elevation="8dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:padding="10dp"
            android:src="@drawable/ic_back"
            android:tint="#FFFFFF"
            android:layout_alignParentStart="true" />

        <TextView
            android:id="@+id/tvTitle"
            android:text="Thêm voucher"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/fm_card"
            android:layout_centerVertical="true"
            android:layout_centerHorizontal="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </RelativeLayout>

    <!-- ================== NỘI DUNG CHÍNH ================== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:text="Nhập mã voucher"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="14dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <EditText
                android:id="@+id/etVoucherCode"
                android:hint="Ví dụ: FUN50"
                android:textSize="16sp"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_edit_text"
                android:padding="12dp"
                android:textColor="#000000"
                android:textColorHint="#9E9E9E"/>


            <Button
                android:id="@+id/btnAddVoucher"
                android:text="Thêm vào ví voucher"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/camdep"
                android:textColor="#FFFFFF"
                android:layout_width="match_parent"
                android:layout_height="50dp"/>
        </LinearLayout>
    </ScrollView>

</LinearLayout>
