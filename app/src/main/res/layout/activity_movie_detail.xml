<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F8">

    <!-- AppBar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_appbar_gradient"
        android:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Chi tiết phim"
            app:titleTextColor="@android:color/white"
            app:navigationIcon="@drawable/ic_arrow_back_24"/>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Nội dung -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:fillViewport="true">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Poster + play overlay -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="240dp">

                <!-- Ảnh poster chính -->
                <ImageView
                    android:id="@+id/ivPoster"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="#E0E0E0" />

            </FrameLayout>


            <!-- Thẻ thông tin nhanh: thumbnail + title + meta -->
            <com.google.android.material.card.MaterialCardView
                android:layout_margin="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:padding="12dp"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/ivThumb"
                        android:layout_width="64dp"
                        android:layout_height="86dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/bg_placeholder"
                        android:background="#DDDDDD"
                        android:layout_marginEnd="12dp"/>

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <TextView
                            android:id="@+id/tvTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kinh Dị Nhật Vị"
                            android:textColor="#111111"
                            android:textStyle="bold"
                            android:textSize="18sp"
                            android:maxLines="1"
                            android:ellipsize="end"/>

                        <TextView
                            android:id="@+id/tvMeta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kinh dị | 104 phút"
                            android:textColor="#666666"
                            android:textSize="13sp"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Bảng thông tin 2 cột -->
            <LinearLayout
                android:paddingHorizontal="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- ĐẠO DIỄN -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="6dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="ĐẠO DIỄN"
                        android:textStyle="bold"
                        android:textColor="#333"
                        android:textSize="13sp"/>
                    <TextView
                        android:id="@+id/tvDirector"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:textColor="#444"
                        android:textSize="13sp"/>
                </LinearLayout>

                <!-- DIỄN VIÊN -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="6dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="DIỄN VIÊN"
                        android:textStyle="bold"
                        android:textColor="#333"
                        android:textSize="13sp"/>
                    <TextView
                        android:id="@+id/tvCast"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:textColor="#444"
                        android:textSize="13sp"/>
                </LinearLayout>

                <!-- TRẠNG THÁI -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="6dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="TRẠNG THÁI"
                        android:textStyle="bold"
                        android:textColor="#333"
                        android:textSize="13sp"/>
                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:textColor="#444"
                        android:textSize="13sp"/>
                </LinearLayout>

                <!-- THỂ LOẠI -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="6dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="THỂ LOẠI"
                        android:textStyle="bold"
                        android:textColor="#333"
                        android:textSize="13sp"/>
                    <TextView
                        android:id="@+id/tvGenre"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:textColor="#444"
                        android:textSize="13sp"/>
                </LinearLayout>

                <!-- THỜI LƯỢNG -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="6dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="THỜI LƯỢNG"
                        android:textStyle="bold"
                        android:textColor="#333"
                        android:textSize="13sp"/>
                    <TextView
                        android:id="@+id/tvDuration"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:textColor="#444"
                        android:textSize="13sp"/>
                </LinearLayout>

                <!-- NGÔN NGỮ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="6dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="NGÔN NGỮ"
                        android:textStyle="bold"
                        android:textColor="#333"
                        android:textSize="13sp"/>
                    <TextView
                        android:id="@+id/tvLanguage"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:textColor="#444"
                        android:textSize="13sp"/>
                </LinearLayout>

                <!-- NGÀY KHỞI CHIẾU -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="6dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="NGÀY KHỞI CHIẾU"
                        android:textStyle="bold"
                        android:textColor="#333"
                        android:textSize="13sp"/>
                    <TextView
                        android:id="@+id/tvRelease"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:textColor="#444"
                        android:textSize="13sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Mô tả -->
            <TextView
                android:id="@+id/tvDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:textColor="#444"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"/>

            <!-- Nút chia sẻ (dùng id btnBook để khỏi sửa code) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBook"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_margin="16dp"
                android:text="Chia sẻ"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                app:icon="@drawable/ic_share_24"
                app:iconTint="@android:color/white"
                android:background="@drawable/bg_appbar_gradient"
                android:textColor="@android:color/white"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
