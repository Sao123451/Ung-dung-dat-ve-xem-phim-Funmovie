<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarDetail"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/orange"
        android:theme="@style/ThemeOverlay.Material3.Dark.ActionBar"
        app:title="@string/news_detail_title"
        app:navigationIcon="@drawable/ic_arrow_back_24"
        app:navigationIconTint="@android:color/white" />

    <!-- ✅ Nội dung cuộn -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Ảnh cover: bo góc, tỉ lệ 16:9 -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgCover"
                android:layout_width="match_parent"
                android:layout_height="275dp"
                android:adjustViewBounds="true"
                android:scaleType="centerCrop"
                app:layout_constraintDimensionRatio="16:9"
                app:shapeAppearanceOverlay="@style/NewsImageShape"
                tools:src="@drawable/ic_launcher_background" />

            <!-- Tiêu đề nổi bật -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textStyle="bold"
                android:textSize="20sp"
                android:textColor="?attr/colorOnSurface"
                tools:text="[Hot] Ưu đãi vé xem phim cuối tuần – Giảm 40% cho suất sau 21:00" />

            <!-- Dòng ngày đăng/metadata -->
            <TextView
                android:id="@+id/tvDate"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Hôm nay, 10:30 • 1.2k lượt xem" />

            <!-- Divider nhẹ -->
            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                app:dividerThickness="1dp"
                app:dividerColor="?attr/colorSurfaceVariant" />

            <!-- Nội dung: giãn dòng + cỡ chữ dễ đọc -->
            <TextView
                android:id="@+id/tvContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="16sp"
                android:lineSpacingExtra="6dp"
                android:textColor="?attr/colorOnSurface"
                tools:text="Nội dung bài viết sẽ hiển thị ở đây. Hỗ trợ văn bản dài, khoảng cách thoáng, dễ đọc..." />

            <!-- Padding đáy cho thoáng khi kéo -->
            <View
                android:layout_width="match_parent"
                android:layout_height="16dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
