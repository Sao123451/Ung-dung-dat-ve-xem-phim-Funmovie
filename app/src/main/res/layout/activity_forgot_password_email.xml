<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F6FA">

    <!-- ====== APP BAR ====== -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbarOtp"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/orange"
            app:navigationIcon="@drawable/ic_back_arrow"
            app:title="Quên mật khẩu"
            app:titleTextColor="@android:color/white" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- ====== NỘI DUNG CHÍNH ====== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:orientation="vertical"
            android:padding="28dp"
            android:gravity="top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- TIÊU ĐỀ -->
            <TextView
                android:text="Quên mật khẩu"
                android:textColor="#111"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp" />

            <!-- MÔ TẢ NGẮN -->
            <TextView
                android:text="Nhập email để nhận mã OTP đặt lại mật khẩu."
                android:textColor="#555"
                android:textSize="14sp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp" />

            <!-- INPUT + ERROR -->
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <EditText
                    android:id="@+id/edtEmail"
                    android:hint="Nhập email của bạn"
                    android:background="@drawable/fm_input"
                    android:padding="16dp"
                    android:inputType="textEmailAddress"
                    android:layout_width="match_parent"
                    android:layout_height="50dp" />

                <!-- ERROR TEXT: cố định chiều cao, alpha=0 (ẩn), KHÔNG ĐẨY LAYOUT -->
                <TextView
                    android:id="@+id/tvError"
                    android:textColor="#D32F2F"
                    android:textSize="14sp"
                    android:paddingTop="4dp"
                    android:alpha="0"
                    android:layout_width="match_parent"
                    android:layout_height="20dp" />
            </LinearLayout>

            <!-- NÚT GỬI OTP -->
            <Button
                android:id="@+id/btnSendOtp"
                android:text="Gửi mã OTP"
                android:textAllCaps="false"
                android:textSize="17sp"
                android:backgroundTint="@color/fm_orange"
                android:layout_marginTop="24dp"
                android:layout_width="match_parent"
                android:layout_height="50dp" />

            <!-- LOADING -->
            <ProgressBar
                android:id="@+id/progress"
                android:visibility="gone"
                android:layout_marginTop="22dp"
                android:layout_gravity="center"
                android:layout_width="40dp"
                android:layout_height="40dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
