<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_seat_selection"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="12dp"
    tools:context=".ChooseSeatActivity">

    <LinearLayout
        android:id="@+id/container_seat_selection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Tiêu đề -->
        <TextView
            android:id="@+id/tv_title_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Đặt Vé"
            android:textColor="#FF6600"
            android:textStyle="bold"
            android:textSize="22sp"
            android:gravity="center"
            android:layout_marginBottom="10dp"/>

        <!-- Thông tin phim (đổ runtime) -->
        <TextView
            android:id="@+id/tv_movie_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Movie Title\n20:20 15/10/2025 | 130 phút"
            android:gravity="center"
            android:background="#F7F7F7"
            android:textSize="14sp"
            android:padding="10dp"
            android:layout_marginBottom="12dp"/>

        <!-- Chú thích + giá ghế do admin đặt -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <View
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="#D3D3D3"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ghế trống    "
                    android:textSize="14sp"
                    android:textColor="#000"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <View
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="#D3D3D3"
                        android:layout_marginEnd="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Giá ghế:"
                        android:textSize="14sp"
                        android:textColor="#000"/>

                    <TextView
                        android:id="@+id/tv_value_seat_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="14sp"
                        android:textColor="#000"
                        android:layout_marginStart="6dp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <View
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="#3A7BFF"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ghế đang chọn"
                    android:textSize="14sp"
                    android:textColor="#000"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="#FF4C4C"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ghế đã bán"
                    android:textSize="14sp"
                    android:textColor="#000"/>
            </LinearLayout>
        </LinearLayout>

