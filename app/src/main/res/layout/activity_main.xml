<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_home"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="#FFFFFF">

    <!-- Tiêu đề -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Trang chủ"
        android:textAlignment="center"
        android:textColor="#F57C00"
        android:textSize="22sp"
        android:textStyle="bold"
        android:paddingTop="12dp"
        android:paddingBottom="6dp" />

    <!-- Tabs: Sắp chiếu | Đang chiếu | Suất chiếu sớm -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/tv_tab_upcoming"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sắp chiếu"
            android:padding="10dp"
            android:textColor="@color/gray"
            android:textSize="16sp"/>

        <TextView
            android:id="@+id/tv_tab_now_showing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đang chiếu"
            android:padding="10dp"
            android:textColor="@color/orange"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tv_tab_early_show"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Suất chiếu sớm"
            android:padding="10dp"
            android:textColor="@color/gray"
            android:textSize="16sp"/>
    </LinearLayout>

    <!-- Banner cố định (không đổi khi đổi tab) -->
    <ImageView
        android:id="@+id/iv_banner"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_launcher_background" />

    <!-- Grid hiển thị danh sách phim -->
    <GridView
        android:id="@+id/grid_movies"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:numColumns="3"
        android:verticalSpacing="8dp"
        android:horizontalSpacing="8dp"
        android:padding="8dp"
        android:clipToPadding="false" />

    <!-- Bottom Navigation bọc CardView -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardUseCompatPadding="true"
        app:cardElevation="5dp"
        app:cardCornerRadius="10dp"
        app:cardBackgroundColor="@color/white">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="#ffffff"
            app:menu="@menu/menu_user"
            app:itemIconSize="30dp"
            app:itemIconTint="@color/color_item_nav_user"
            app:itemTextColor="#4C4DDC"
            app:labelVisibilityMode="unlabeled"/>
    </androidx.cardview.widget.CardView>

</LinearLayout>
