<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Nền trắng -->
    <solid android:color="#FFFFFF"/>

    <!-- Viền đậm rõ -->
    <stroke
        android:width="2dp"
        android:color="#C4C4C4"/>

    <!-- Bo góc -->
    <corners android:radius="10dp"/>

    <!-- Khoảng cách nội -->
    <padding
        android:left="12dp"
        android:top="12dp"
        android:right="12dp"
        android:bottom="12dp" />

</shape>
