<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Nền trắng -->
    <solid android:color="#FFFFFF" />

    <!-- Viền cam nổi bật -->
    <stroke
        android:width="2dp"
        android:color="#FF7A00" /> <!-- Màu cam đẹp -->

    <!-- Bo góc mềm -->
    <corners android:radius="16dp" />

    <!-- Padding nhẹ cho card -->
    <padding
        android:left="16dp"
        android:top="16dp"
        android:right="16dp"
        android:bottom="16dp" />
</shape>
